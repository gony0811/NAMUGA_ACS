{
  "Acs": {
    "Process": {
      "Name": "HS01_P",
      "Type": "host"
    },
    "Api": {
      "ListenPort": "5101"
    }
  },
  "Serilog": {
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/HS01_P-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}