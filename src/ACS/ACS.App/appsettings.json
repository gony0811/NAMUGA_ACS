{
  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=5432;Database=acsdb;Username=postgres;Password=1234"
  },
  "Acs": {
    "Database": {
      "Type": "POSTGRESQL"
    },
    "Site": {
      "Name": "NAMUGA"
    },
    "Process": {
      "Name": "CS01_P",
      "Type": "control",
      "HardwareType": "PRIMARY",
      "Msb": "rabbitmq",
      "Base": "database",
      "ServicePath": "reload/trans"
    },
    "Amr": {
      "NearestNodeThresholdMeters": 0.5
    },
    "Api": {
      "ListenIP": "any",
      "ListenPort": "5100",
      "ClientReleasePath": "C:\\acs\\releases\\ui"
    },
    "LogDeleteDays": 7,
    "Logging": {
      "Database": {
        "Enabled": true,
        "Level": "INFO",
        "QueueCapacity": 10000,
        "BatchSize": 200
      }
    },
    "Control": {
      "Scripts": {
        "TS-START": "C:\\ACS\\deploy\\TS01_P\\TS01_P.exe",
        "ES-START": "C:\\ACS\\deploy\\ES01_P\\ES01_P.exe",
        "DS-START": "C:\\ACS\\deploy\\DS01_P\\DS01_P.exe",
        "HS-START": "C:\\ACS\\deploy\\HS01_P\\HS01_P.exe"
      }
    }
  },
  "Host": {
    "Domain": {
      "ConnectUrl": "localhost",
      "Username": "guest",
      "Password": "guest",
      "StationMode": "INTER"
    },
    "Tcp": {
      "ListenPort": 3334,
      "SendHost": "10.0.26.2",
      "SendPort": 3333,
      "ReconnectIntervalMs": 5000
    }
  },
  "Destination": {
    "Server": {
      "Domain": {
        "ConnectUrl": "10.0.26.2",
        "Username": "guest",
        "Password": "guest",
        "StationMode": "INTER"
      },
      "Ts": {
        "Control": {
          "Listener": {
            "Destination": "${server.domain}/CONTROL/AGENT/@{application}"
          }
        },
        "Es": {
          "Listener": {
            "Destination": "${server.domain}/ES/LISTENER"
          },
          "Sender": {
            "Destination": "${server.domain}/ES/SENDER"
          }
        },
        "Host": {
          "Listener": {
            "Destination": "${server.domain}/HOST/LISTENER"
          },
          "Sender": {
            "Destination": "${server.domain}/HOST/SENDER"
          }
        },
        "Ui": {
          "Listener": {
            "Destination": "${server.domain}/UI/LISTENER"
          },
          "Sender": {
            "Destination": "${server.domain}/UI/SENDER"
          }
        },
        "Daemon": {
          "Listener": {
            "Destination": "${server.domain}/DAEMON/LISTENER"
          }
        },
        "XpathOfMessageName": {
          "Default": "/MESSAGE/HEADER/MESSAGENAME"
        }
      },
      "Daemon": {
        "Control": {
          "Listener": {
            "Destination": "${server.domain}/CONTROL/AGENT/@{application}"
          }
        },
        "Ts": {
          "Sender": {
            "Destination": "${server.domain}/DAEMON/LISTENER"
          }
        },
        "Ui": {
          "Sender": {
            "Destination": "${server.domain}/UI/SENDER.*"
          }
        }
      },
      "Control": {
        "Control": {
          "Listener": {
            "Destination": "${server.domain}/CONTROL/AGENT/@{application}"
          }
        },
        "Ts": {
          "Sender": {
            "Destination": "${server.domain}/CONTROL/AGENT/LISTENER"
          }
        },
        "Ui": {
          "Sender": {
            "Destination": "${server.domain}/UI/SENDER"
          }
        },
        "XpathOfMessageName": {
          "Default": "/MESSAGE/HEADER/MESSAGENAME"
        },
        "All": {
          "Destination": {
            "Prefix": "${server.domain}/CONTROL/AGENT"
          }
        }
      },
      "Es": {
        "Control": {
          "Listener": {
            "Destination": "${server.domain}/CONTROL/AGENT/@{application}"
          }
        },
        "Ts": {
          "Listener": {
            "Destination": "${server.domain}/ES/@{application}"
          },
          "Sender": {
            "Destination": "${server.domain}/ES/LISTENER"
          }
        }
      },
      "Trans": {
        "XpathOfMessageName": {
          "Host": "/Msg/Command"
        }
      },
      "DomainValue": "VM/DEMO"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Expressions" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Quartz": "Information"
      }
    },
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "Contains(@m, 'AMR heartbeat 수신') or Contains(@m, 'VEHICLE-HEARTBEAT') or (Contains(@m, 'topic=amr/') and Contains(@m, '/heartbeat'))"
        }
      }
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
