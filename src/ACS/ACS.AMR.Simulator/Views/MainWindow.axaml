<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ACS.AMR.Simulator.ViewModels"
        xmlns:model="using:ACS.Core.Resource.Model"
        x:Class="ACS.AMR.Simulator.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ACS AMR Simulator"
        Width="1100" Height="750"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10" RowDefinitions="*,Auto,150">

        <!-- Row 0: 탭 (DB 주입 / MQTT 가상 차량) -->
        <TabControl Grid.Row="0">

            <!-- ═══════════ 탭 1: DB 주입 (기존 UI) ═══════════ -->
            <TabItem Header="DB 주입">
                <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">

                    <!-- 툴바 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <Button Content="Load Vehicles" Command="{Binding LoadVehiclesCommand}" />
                        <Button Content="Add Vehicle" Command="{Binding AddVehicleCommand}" />
                        <Button Content="Save Selected" Command="{Binding SaveSelectedCommand}" />
                        <Button Content="Save All" Command="{Binding SaveAllCommand}" />
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="20,0,0,0"
                                   Foreground="Gray" FontSize="13" />
                    </StackPanel>

                    <!-- 메인 영역 (Vehicle 리스트 + 편집 패널) -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,350">

                        <!-- 왼쪽: Vehicle DataGrid -->
                        <DataGrid Grid.Column="0" Margin="0,0,8,0"
                                  ItemsSource="{Binding Vehicles}"
                                  SelectedItem="{Binding SelectedVehicle}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserResizeColumns="True"
                                  GridLinesVisibility="Horizontal"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Vehicle ID" Binding="{Binding VehicleId}" Width="90" />
                                <DataGridTextColumn Header="Connection" Binding="{Binding ConnectionState}" Width="90" />
                                <DataGridTextColumn Header="Processing" Binding="{Binding ProcessingState}" Width="80" />
                                <DataGridTextColumn Header="Run" Binding="{Binding RunState}" Width="60" />
                                <DataGridTextColumn Header="Alarm" Binding="{Binding AlarmState}" Width="70" />
                                <DataGridTextColumn Header="Battery" Binding="{Binding BatteryRate}" Width="60" />
                                <DataGridTextColumn Header="Node" Binding="{Binding CurrentNodeId}" Width="80" />
                                <DataGridTextColumn Header="Transfer" Binding="{Binding TransferState}" Width="100" />
                                <DataGridTextColumn Header="TC ID" Binding="{Binding TransportCommandId}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 오른쪽: 편집 패널 -->
                        <Border Grid.Column="1" BorderBrush="#ddd" BorderThickness="1" CornerRadius="4" Padding="12"
                                IsEnabled="{Binding SelectedVehicle, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <ScrollViewer>
                                <StackPanel Spacing="10" DataContext="{Binding SelectedVehicle}">

                                    <TextBlock Text="Vehicle 상태 편집" FontSize="16" FontWeight="Bold" Margin="0,0,0,6" />

                                    <TextBlock Text="{Binding VehicleId, StringFormat='Vehicle: {0}'}"
                                               FontSize="14" FontWeight="SemiBold" Foreground="#1565c0" />

                                    <!-- Connection State -->
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Connection State" FontSize="12" Foreground="Gray" />
                                        <ComboBox ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ConnectionStates}"
                                                  SelectedItem="{Binding ConnectionState}" HorizontalAlignment="Stretch" />
                                    </StackPanel>

                                    <!-- Processing State -->
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Processing State" FontSize="12" Foreground="Gray" />
                                        <ComboBox ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ProcessingStates}"
                                                  SelectedItem="{Binding ProcessingState}" HorizontalAlignment="Stretch" />
                                    </StackPanel>

                                    <!-- Run State -->
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Run State" FontSize="12" Foreground="Gray" />
                                        <ComboBox ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RunStates}"
                                                  SelectedItem="{Binding RunState}" HorizontalAlignment="Stretch" />
                                    </StackPanel>

                                    <!-- Alarm State -->
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Alarm State" FontSize="12" Foreground="Gray" />
                                        <ComboBox ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AlarmStates}"
                                                  SelectedItem="{Binding AlarmState}" HorizontalAlignment="Stretch" />
                                    </StackPanel>

                                    <!-- Transfer State -->
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Transfer State" FontSize="12" Foreground="Gray" />
                                        <ComboBox ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TransferStates}"
                                                  SelectedItem="{Binding TransferState}" HorizontalAlignment="Stretch" />
                                    </StackPanel>

                                    <!-- Full State -->
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Full State" FontSize="12" Foreground="Gray" />
                                        <ComboBox ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).FullStates}"
                                                  SelectedItem="{Binding FullState}" HorizontalAlignment="Stretch" />
                                    </StackPanel>

                                    <!-- Current Node -->
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Current Node ID" FontSize="12" Foreground="Gray" />
                                        <TextBox Text="{Binding CurrentNodeId}" />
                                    </StackPanel>

                                    <!-- Battery Rate -->
                                    <StackPanel Spacing="3">
                                        <TextBlock FontSize="12" Foreground="Gray">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="Battery Rate: {0}%">
                                                    <Binding Path="BatteryRate" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <Slider Minimum="0" Maximum="100" Value="{Binding BatteryRate}"
                                                TickFrequency="10" IsSnapToTickEnabled="False" />
                                    </StackPanel>

                                    <!-- Battery Voltage -->
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Battery Voltage" FontSize="12" Foreground="Gray" />
                                        <NumericUpDown Value="{Binding BatteryVoltage}" Minimum="0" Maximum="30"
                                                       Increment="0.1" FormatString="F1" />
                                    </StackPanel>

                                    <!-- Transport Command ID -->
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Transport Command ID" FontSize="12" Foreground="Gray" />
                                        <TextBox Text="{Binding TransportCommandId}" />
                                    </StackPanel>

                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═══════════ 탭 2: MQTT 가상 차량 ═══════════ -->
            <TabItem Header="MQTT 가상 차량">
                <Grid RowDefinitions="Auto,Auto,*" Margin="0,8,0,0" DataContext="{Binding MqttSim}">

                    <!-- Row 0: 브로커 설정 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <Button Content="NA_C_MQTT 로드" Command="{Binding LoadBrokerConfigCommand}" />
                        <TextBlock Text="Broker" VerticalAlignment="Center" Foreground="Gray" />
                        <TextBox Text="{Binding BrokerIp}" Width="130" Watermark="broker ip" />
                        <NumericUpDown Value="{Binding BrokerPort}" Minimum="1" Maximum="65535" Increment="1"
                                       FormatString="0" Width="110" />
                        <TextBlock Text="Prefix" VerticalAlignment="Center" Foreground="Gray" />
                        <TextBox Text="{Binding TopicPrefix}" Width="70" />
                        <Button Content="연결" Command="{Binding ConnectCommand}"
                                IsEnabled="{Binding !IsConnected}" />
                        <Button Content="해제" Command="{Binding DisconnectCommand}"
                                IsEnabled="{Binding IsConnected}" />
                        <TextBlock Text="{Binding MqttStatus}" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Foreground="Gray" FontSize="13" />
                    </StackPanel>

                    <!-- Row 1: 차량 선택/시작 툴바 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <Button Content="차량 목록 로드" Command="{Binding LoadMqttVehiclesCommand}" />
                        <ComboBox ItemsSource="{Binding MqttVehicles}" SelectedItem="{Binding SelectedVehicle}"
                                  Width="200" PlaceholderText="CommType=MQTT 차량 선택">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="model:VehicleExs">
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} ({1})">
                                                <Binding Path="VehicleId" />
                                                <Binding Path="CommId" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="가상 차량 시작" Command="{Binding StartSelectedCommand}"
                                IsEnabled="{Binding IsConnected}" />
                        <Button Content="정지" Command="{Binding StopSelectedCommand}" />
                        <Button Content="노드 좌표 갱신" Command="{Binding LoadNodePositionsCommand}" />
                    </StackPanel>

                    <!-- Row 2: 실행 중 가상 차량 목록 + 제어 패널 -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,330">

                        <DataGrid Grid.Column="0" Margin="0,0,8,0"
                                  ItemsSource="{Binding RunningAmrs}"
                                  SelectedItem="{Binding SelectedAmr}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Vehicle" Binding="{Binding VehicleId}" Width="90" />
                                <DataGridTextColumn Header="CommId" Binding="{Binding CommId}" Width="90" />
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90" />
                                <DataGridTextColumn Header="Pose" Binding="{Binding Pose}" Width="130" />
                                <DataGridTextColumn Header="CmdId" Binding="{Binding LastCmdId}" Width="150" />
                                <DataGridTextColumn Header="JobType" Binding="{Binding LastJobType}" Width="90" />
                                <DataGridCheckBoxColumn Header="Auto" Binding="{Binding AutoMode}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 선택 차량 제어 패널 -->
                        <Border Grid.Column="1" BorderBrush="#ddd" BorderThickness="1" CornerRadius="4" Padding="12"
                                IsEnabled="{Binding SelectedAmr, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <ScrollViewer>
                                <StackPanel Spacing="10" DataContext="{Binding SelectedAmr}">

                                    <TextBlock Text="가상 차량 제어" FontSize="16" FontWeight="Bold" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding VehicleId, StringFormat='Vehicle: {0}'}"
                                               FontSize="14" FontWeight="SemiBold" Foreground="#1565c0" />

                                    <CheckBox Content="자동 모드 (수신 즉시 이동→도착→완료)" IsChecked="{Binding AutoMode}" />

                                    <StackPanel Spacing="3">
                                        <TextBlock Text="이동 속도 (m/s)" FontSize="12" Foreground="Gray" />
                                        <NumericUpDown Value="{Binding SpeedMetersPerSec}" Minimum="0.1" Maximum="10"
                                                       Increment="0.1" FormatString="F1" />
                                    </StackPanel>

                                    <StackPanel Spacing="3">
                                        <TextBlock Text="작업 시간 (ms)" FontSize="12" Foreground="Gray" />
                                        <NumericUpDown Value="{Binding WorkingTimeMs}" Minimum="0" Maximum="60000"
                                                       Increment="500" FormatString="0" />
                                    </StackPanel>

                                    <StackPanel Spacing="3">
                                        <TextBlock Text="배터리 (%)" FontSize="12" Foreground="Gray" />
                                        <Slider Minimum="0" Maximum="100" Value="{Binding BatteryLevel}" />
                                    </StackPanel>

                                    <StackPanel Spacing="3">
                                        <TextBlock Text="실패 주입" FontSize="12" Foreground="Gray" />
                                        <ComboBox ItemsSource="{Binding FailureModes}" SelectedItem="{Binding FailureMode}"
                                                  HorizontalAlignment="Stretch" />
                                        <TextBlock Text="resultCode (0 이외)" FontSize="12" Foreground="Gray" />
                                        <NumericUpDown Value="{Binding FailureResultCode}" Minimum="1" Maximum="9999"
                                                       Increment="1" FormatString="0" />
                                    </StackPanel>

                                    <Separator Margin="0,4" />

                                    <TextBlock Text="수동 진행 (자동 모드 OFF 시)" FontSize="12" Foreground="Gray" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="도착" Command="{Binding ArriveCommand}" />
                                        <Button Content="완료" Command="{Binding CompleteCommand}" />
                                        <Button Content="실패" Command="{Binding FailCommand}" />
                                    </StackPanel>

                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Row 1: 구분선 -->
        <Separator Grid.Row="1" Margin="0,8" />

        <!-- Row 2: 로그 (탭 공용) -->
        <TextBox Grid.Row="2" Text="{Binding LogText}" IsReadOnly="True"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 FontFamily="Consolas,Menlo,monospace" FontSize="11"
                 VerticalContentAlignment="Top" />
    </Grid>
</Window>
