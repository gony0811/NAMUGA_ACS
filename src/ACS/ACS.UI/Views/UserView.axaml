<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ACS.UI.ViewModels"
             x:Class="ACS.UI.Views.UserView"
             x:DataType="vm:UserViewModel">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Row 0: Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource AcsTabBarBrush}"
                BorderBrush="{StaticResource AcsSectionBorderBrush}"
                BorderThickness="0,0,0,1" Padding="6,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="&#x1F465;" FontSize="14"
                               Foreground="{StaticResource AcsPrimaryBlueBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="User Management" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource AcsPrimaryBlueBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalCount, StringFormat='[{0}] Rows'}"
                               FontSize="12"
                               Foreground="{StaticResource AcsTextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center" Margin="0,0,4,0">
                    <StackPanel.Styles>
                        <Style Selector="Button">
                            <Setter Property="Padding" Value="12,5" />
                            <Setter Property="FontSize" Value="12" />
                        </Style>
                    </StackPanel.Styles>
                    <Button Content="Add" ToolTip.Tip="Add User" Command="{Binding AddUserCommand}" />
                    <Button Content="Edit" ToolTip.Tip="Edit User" Command="{Binding EditUserCommand}" />
                    <Button Content="Reset PW" ToolTip.Tip="비밀번호 리셋"
                            Command="{Binding ResetPasswordCommand}" />
                    <Button Content="Delete" ToolTip.Tip="Delete User"
                            Command="{Binding DeleteUserCommand}" />
                    <Border Width="1" Background="{StaticResource AcsSectionBorderBrush}" Margin="4,4" />
                    <Button Content="Change My PW" ToolTip.Tip="내 비밀번호 변경"
                            Command="{Binding ChangeMyPasswordCommand}" />
                    <Border Width="1" Background="{StaticResource AcsSectionBorderBrush}" Margin="4,4" />
                    <Button Content="Refresh" ToolTip.Tip="Refresh" Command="{Binding LoadUsersCommand}" />
                </StackPanel>

                <Panel />
            </DockPanel>
        </Border>

        <!-- Row 1: Table Option -->
        <Border Grid.Row="1" Background="{StaticResource AcsSurfaceCardBrush}"
                BorderBrush="{StaticResource AcsSectionBorderBrush}"
                BorderThickness="0,0,0,1" Padding="6,4">
            <StackPanel>
                <TextBlock Text="&#x25BC; Table Option" FontSize="11"
                           Foreground="{StaticResource AcsTextPrimaryBrush}" />
                <TextBlock Text="NA_X_USER" FontSize="11" Margin="12,2,0,0"
                           Foreground="{StaticResource AcsPrimaryBlueBrush}" />
            </StackPanel>
        </Border>

        <!-- Row 2: DataGrid (PasswordHash 절대 노출 안 함) -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Users}"
                  SelectedItem="{Binding SelectedUser}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="All"
                  BorderThickness="0"
                  Background="{StaticResource AcsSurfaceCardBrush}"
                  FontSize="11"
                  RowHeight="26"
                  HeadersVisibility="Column">

            <DataGrid.Styles>
                <Style Selector="DataGridColumnHeader">
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="Padding" Value="8,4" />
                </Style>
            </DataGrid.Styles>

            <DataGrid.Columns>
                <DataGridTextColumn Header="SEQ" Binding="{Binding Seq}" Width="60" />
                <DataGridTextColumn Header="USER ID" Binding="{Binding UserId}" Width="140" />
                <DataGridTextColumn Header="ROLE" Binding="{Binding Role}" Width="100" />
                <DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding IsActive}" Width="80" />
                <DataGridCheckBoxColumn Header="MUST CHG PW" Binding="{Binding MustChangePassword}" Width="110" />
                <DataGridTextColumn Header="LAST LOGIN" Binding="{Binding LastLoginTime}" Width="160" />
                <DataGridTextColumn Header="CREATED" Binding="{Binding CreateTime}" Width="160" />
                <DataGridTextColumn Header="EDITOR" Binding="{Binding Editor}" Width="100" />
                <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
