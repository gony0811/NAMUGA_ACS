<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ACS.UI.Views.ChangePasswordWindow"
        Title="비밀번호 변경"
        Width="400" Height="290"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource AcsSurfaceBaseBrush}"
        Foreground="{StaticResource AcsTextPrimaryBrush}">

    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <TextBlock Grid.Row="0" x:Name="HeaderText"
                   Text="비밀번호를 변경하세요"
                   FontSize="14" FontWeight="SemiBold"
                   Foreground="{StaticResource AcsLightBlueBrush}"
                   Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" x:Name="SubText"
                   Text="최초 로그인입니다. 새 비밀번호를 설정해주세요."
                   FontSize="11"
                   Foreground="{StaticResource AcsTextSecondaryBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14" />

        <Grid Grid.Row="2" ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto" Margin="0,0,0,8">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="현재 비밀번호:"
                       VerticalAlignment="Center" FontSize="12" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="CurrentTextBox"
                     PasswordChar="*" FontSize="12" Height="28" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="새 비밀번호:"
                       VerticalAlignment="Center" FontSize="12" Margin="0,6,0,0" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="NewTextBox"
                     PasswordChar="*" FontSize="12" Height="28" Margin="0,6,0,0" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="새 비밀번호 확인:"
                       VerticalAlignment="Center" FontSize="12" Margin="0,6,0,0" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="ConfirmTextBox"
                     PasswordChar="*" FontSize="12" Height="28" Margin="0,6,0,0" />
        </Grid>

        <TextBlock Grid.Row="3" x:Name="ErrorText"
                   Foreground="#D14343" FontSize="11"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="False" TextWrapping="Wrap" />

        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Center" Spacing="12" Margin="0,8,0,0">
            <Button Content="변경" x:Name="OkButton" Width="90" Height="28"
                    Click="OnOkClick" IsDefault="True"
                    Background="{StaticResource AcsPrimaryBlueBrush}"
                    Foreground="White" />
            <Button Content="취소" x:Name="CancelButton" Width="90" Height="28"
                    Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
