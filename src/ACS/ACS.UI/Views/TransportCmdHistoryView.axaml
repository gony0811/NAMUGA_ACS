<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ACS.UI.ViewModels"
             x:Class="ACS.UI.Views.TransportCmdHistoryView"
             x:DataType="vm:TransportCmdHistoryViewModel">

    <Grid RowDefinitions="Auto,*">

        <!-- Row 0: 필터 바 -->
        <Border Grid.Row="0" Background="{StaticResource AcsTabBarBrush}"
                BorderBrush="{StaticResource AcsSectionBorderBrush}"
                BorderThickness="0,0,0,1" Padding="8,6">
            <Border.Styles>
                <Style Selector="TextBlock.label">
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Foreground" Value="{StaticResource AcsTextMutedBrush}" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="0,0,4,0" />
                </Style>
                <Style Selector="TextBox">
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="MinHeight" Value="28" />
                </Style>
                <Style Selector="Button">
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Padding" Value="10,5" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </Border.Styles>

            <StackPanel Spacing="6">
                <!-- 1행: 시간 범위 + State + JobType + Limit -->
                <WrapPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,4" VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="From" />
                        <CalendarDatePicker SelectedDate="{Binding FromDate}" Width="130" FontSize="11" />
                        <TimePicker SelectedTime="{Binding FromTime}" ClockIdentifier="24HourClock" FontSize="11" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,4" VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="To" />
                        <CalendarDatePicker SelectedDate="{Binding ToDate}" Width="130" FontSize="11" />
                        <TimePicker SelectedTime="{Binding ToTime}" ClockIdentifier="24HourClock" FontSize="11" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,4" VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="State" />
                        <ComboBox ItemsSource="{Binding States}"
                                  SelectedItem="{Binding SelectedState}"
                                  Width="110" FontSize="11" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,4" VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="JobType" />
                        <ComboBox ItemsSource="{Binding JobTypes}"
                                  SelectedItem="{Binding SelectedJobType}"
                                  Width="100" FontSize="11" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,4" VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="Limit" />
                        <TextBox Text="{Binding Limit}" Width="70" />
                    </StackPanel>
                </WrapPanel>

                <!-- 2행: 텍스트 필터 + 액션 -->
                <WrapPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="JobId" />
                        <TextBox Text="{Binding JobId}" Width="140" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="VehicleId" />
                        <TextBox Text="{Binding VehicleId}" Width="110" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="CarrierId" />
                        <TextBox Text="{Binding CarrierId}" Width="110" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="BayId" />
                        <TextBox Text="{Binding BayId}" Width="90" />
                    </StackPanel>

                    <Button Content="🔍 Search" Command="{Binding SearchCommand}"
                            Background="{StaticResource AcsPrimaryBlueBrush}" Foreground="White"
                            Margin="0,0,6,0" />
                    <Button Content="Clear" Command="{Binding ClearCommand}" Margin="0,0,12,0" />
                    <CheckBox Content="Auto-Refresh (5s)" IsChecked="{Binding AutoRefreshEnabled}"
                              FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding StatusMessage}" Classes="label"
                               Foreground="{StaticResource AcsTextSecondaryBrush}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Row 1: 그리드 + 상세 패널 (세로 분할) -->
        <Grid Grid.Row="1" RowDefinitions="*,4,170">

            <DataGrid Grid.Row="0"
                      ItemsSource="{Binding Histories}"
                      SelectedItem="{Binding SelectedHistory}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      CanUserReorderColumns="True"
                      GridLinesVisibility="All"
                      BorderThickness="0"
                      Background="{StaticResource AcsSurfaceCardBrush}"
                      FontSize="11"
                      RowHeight="24"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TIME"
                                        Binding="{Binding LocalTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss.fff}'}"
                                        Width="160" />
                    <DataGridTextColumn Header="JOB ID" Binding="{Binding JobId}" Width="140" />
                    <DataGridTextColumn Header="STATE" Binding="{Binding State}" Width="100" />
                    <DataGridTextColumn Header="VEHICLE" Binding="{Binding VehicleId}" Width="90" />
                    <DataGridTextColumn Header="CARRIER" Binding="{Binding CarrierId}" Width="110" />
                    <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="100" />
                    <DataGridTextColumn Header="DEST" Binding="{Binding Dest}" Width="100" />
                    <DataGridTextColumn Header="JOB TYPE" Binding="{Binding JobType}" Width="90" />
                    <DataGridTextColumn Header="BAY" Binding="{Binding BayId}" Width="80" />
                    <DataGridTextColumn Header="EQP" Binding="{Binding EqpId}" Width="90" />
                    <DataGridTextColumn Header="PORT" Binding="{Binding PortId}" Width="80" />
                    <DataGridTextColumn Header="CREATE"
                                        Binding="{Binding CreateTime, StringFormat='{}{0:HH:mm:ss}'}"
                                        Width="80" />
                    <DataGridTextColumn Header="ASSIGNED"
                                        Binding="{Binding AssignedTime, StringFormat='{}{0:HH:mm:ss}'}"
                                        Width="80" />
                    <DataGridTextColumn Header="COMPLETED"
                                        Binding="{Binding CompletedTime, StringFormat='{}{0:HH:mm:ss}'}"
                                        Width="80" />
                    <DataGridTextColumn Header="REASON" Binding="{Binding Reason}" Width="100" />
                    <DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="80" />
                    <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="1" ResizeDirection="Rows"
                          Background="{StaticResource AcsBorderStrongBrush}" />

            <!-- 상세 패널: 선택된 행의 전체 필드 dump -->
            <Border Grid.Row="2" Background="{StaticResource AcsSurfacePanelBrush}"
                    BorderBrush="{StaticResource AcsSectionBorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="Detail" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource AcsTextSecondaryBrush}"
                               Margin="8,5" />
                    <TextBox Grid.Row="1"
                             Text="{Binding SelectedHistoryDetail, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas, monospace"
                             FontSize="11"
                             Background="{StaticResource AcsSurfaceCardBrush}"
                             BorderThickness="0"
                             VerticalContentAlignment="Top"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             Margin="4,0,4,4" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
