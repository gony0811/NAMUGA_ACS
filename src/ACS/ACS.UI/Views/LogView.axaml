<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ACS.UI.ViewModels"
             xmlns:conv="using:ACS.UI.Converters"
             x:Class="ACS.UI.Views.LogView"
             x:DataType="vm:LogViewModel">

    <UserControl.Resources>
        <conv:LogLevelToColorConverter x:Key="LogLevelToColor" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Row 0: 필터 바 -->
        <Border Grid.Row="0" Background="{StaticResource AcsTabBarBrush}"
                BorderBrush="{StaticResource AcsSectionBorderBrush}"
                BorderThickness="0,0,0,1" Padding="8,6">
            <Border.Styles>
                <Style Selector="TextBlock.label">
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Foreground" Value="{StaticResource AcsTextMutedBrush}" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="0,0,4,0" />
                </Style>
                <Style Selector="TextBox">
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="MinHeight" Value="28" />
                </Style>
                <Style Selector="Button">
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Padding" Value="10,5" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </Border.Styles>

            <StackPanel Spacing="6">
                <!-- 1행: 시간 범위 + 레벨 + 버튼 -->
                <WrapPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,4" VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="From" />
                        <CalendarDatePicker SelectedDate="{Binding FromDate}" Width="130" FontSize="11" />
                        <TimePicker SelectedTime="{Binding FromTime}" ClockIdentifier="24HourClock" FontSize="11" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,4" VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="To" />
                        <CalendarDatePicker SelectedDate="{Binding ToDate}" Width="130" FontSize="11" />
                        <TimePicker SelectedTime="{Binding ToTime}" ClockIdentifier="24HourClock" FontSize="11" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,4" VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="Level" />
                        <ComboBox ItemsSource="{Binding LogLevels}"
                                  SelectedItem="{Binding SelectedLogLevel}"
                                  Width="100" FontSize="11" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,4" VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="Limit" />
                        <TextBox Text="{Binding Limit}" Width="70" />
                    </StackPanel>
                </WrapPanel>

                <!-- 2행: 텍스트 필터 + 액션 -->
                <WrapPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="Keyword" />
                        <TextBox Text="{Binding Keyword}" Width="160"
                                 Watermark="메시지 본문 검색" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="Process" />
                        <TextBox Text="{Binding ProcessName}" Width="110" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="MsgName" />
                        <TextBox Text="{Binding MessageName}" Width="120" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="TxId" />
                        <TextBox Text="{Binding TransactionId}" Width="120" />
                    </StackPanel>

                    <Button Content="🔍 Search" Command="{Binding SearchCommand}"
                            Background="{StaticResource AcsPrimaryBlueBrush}" Foreground="White"
                            Margin="0,0,6,0" />
                    <Button Content="Clear" Command="{Binding ClearCommand}" Margin="0,0,12,0" />
                    <CheckBox Content="Auto-Refresh (5s)" IsChecked="{Binding AutoRefreshEnabled}"
                              FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding StatusMessage}" Classes="label"
                               Foreground="{StaticResource AcsTextSecondaryBrush}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Row 1: 그리드 + 상세 패널 (세로 분할) -->
        <Grid Grid.Row="1" RowDefinitions="*,4,170">

            <DataGrid Grid.Row="0"
                      ItemsSource="{Binding Logs}"
                      SelectedItem="{Binding SelectedLog}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      CanUserReorderColumns="True"
                      GridLinesVisibility="All"
                      BorderThickness="0"
                      Background="{StaticResource AcsSurfaceCardBrush}"
                      FontSize="11"
                      RowHeight="24"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TIME"
                                        Binding="{Binding LocalTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss.fff}'}"
                                        Width="160" />
                    <DataGridTemplateColumn Header="LEVEL" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LogLevel}" Margin="4,0" VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding LogLevel, Converter={StaticResource LogLevelToColor}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="PROCESS" Binding="{Binding ProcessName}" Width="90" />
                    <DataGridTextColumn Header="MESSAGE NAME" Binding="{Binding MessageName}" Width="140" />
                    <DataGridTextColumn Header="TRANSACTION ID" Binding="{Binding TransactionId}" Width="130" />
                    <DataGridTextColumn Header="TEXT" Binding="{Binding Text}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="1" ResizeDirection="Rows"
                          Background="{StaticResource AcsBorderStrongBrush}" />

            <!-- 상세 패널: 전체 메시지(NA_L_LARGELOGMESSAGE 재조합) -->
            <Border Grid.Row="2" Background="{StaticResource AcsSurfacePanelBrush}"
                    BorderBrush="{StaticResource AcsSectionBorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="Full Message" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource AcsTextSecondaryBrush}"
                               Margin="8,5" />
                    <TextBox Grid.Row="1"
                             Text="{Binding SelectedLogFullText, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontFamily="Consolas, monospace"
                             FontSize="11"
                             Background="{StaticResource AcsSurfaceCardBrush}"
                             BorderThickness="0"
                             VerticalContentAlignment="Top"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Margin="4,0,4,4" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
