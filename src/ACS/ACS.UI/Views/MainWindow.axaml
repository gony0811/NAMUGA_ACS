<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ACS.UI.ViewModels"
        xmlns:views="using:ACS.UI.Views"
        xmlns:svc="using:ACS.UI.Services"

        x:Class="ACS.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ACS - AMR Control System"
        Width="1400" Height="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Inter"
        Background="{StaticResource AcsSurfaceBaseBrush}"
        Foreground="{StaticResource AcsTextPrimaryBrush}">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="{StaticResource AcsHeaderBrush}"
                Padding="12,5">
            <TextBlock Text="ACS GUI"
                       Foreground="White"
                       FontSize="13" FontWeight="SemiBold"
                       LetterSpacing="0.3" />
        </Border>

        <!-- Ribbon Tab Header + Content (combined) -->
        <Border Grid.Row="1" Background="{StaticResource AcsTabBarBrush}"
                Padding="0">
            <Grid RowDefinitions="Auto,Auto">
                <!-- Tab Strip -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="0"
                            Margin="4,0,0,0">
                    <StackPanel.Styles>
                        <!-- Ribbon tab base style: ControlTemplate 재정의로 원형 체크 제거 -->
                        <Style Selector="RadioButton">
                            <Setter Property="Padding" Value="14,5" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Foreground" Value="{StaticResource AcsTextSecondaryBrush}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="1,1,1,0" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="CornerRadius" Value="3,3,0,0" />
                            <Setter Property="Margin" Value="1,4,1,0" />
                            <Setter Property="MinHeight" Value="26" />
                            <Setter Property="Template">
                                <ControlTemplate>
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{TemplateBinding CornerRadius}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter>
                        </Style>
                        <!-- Selected tab: raised with border, merges into content -->
                        <Style Selector="RadioButton:checked">
                            <Setter Property="Foreground" Value="{StaticResource AcsLightBlueBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Background" Value="{StaticResource AcsSurfaceCardBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource AcsBorderStrongBrush}" />
                        </Style>
                        <!-- Hover -->
                        <Style Selector="RadioButton:pointerover:not(:checked)">
                            <Setter Property="Background" Value="{StaticResource AcsSurfaceOverlayBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AcsTextPrimaryBrush}" />
                        </Style>
                    </StackPanel.Styles>

                    <RadioButton Content="Dashboard" GroupName="Tabs"
                                 IsChecked="{Binding IsTab0Selected}" />
                    <RadioButton Content="Data View" GroupName="Tabs"
                                 IsChecked="{Binding IsTab3Selected}" />
                    <RadioButton Content="History" GroupName="Tabs"
                                 IsChecked="{Binding IsTab4Selected}" />
                    <RadioButton Content="Log" GroupName="Tabs"
                                 IsChecked="{Binding IsTab5Selected}" />
                    <RadioButton Content="Application" GroupName="Tabs"
                                 IsChecked="{Binding IsTab6Selected}" />
                </StackPanel>

                <!-- Ribbon Content Area (border merges with selected tab) -->
                <Border Grid.Row="1"
                        Background="{StaticResource AcsSurfaceCardBrush}"
                        BorderBrush="{StaticResource AcsBorderStrongBrush}"
                        BorderThickness="0,1,0,0">
                    <Panel>
                        <!-- Dashboard -->
                        <views:DashboardView DataContext="{Binding DashboardViewModel}"
                                             IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsTab0Selected}" />

                        <!-- Data View -->
                        <views:DataViewRibbonView DataContext="{Binding DataViewViewModel}"
                                                  IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsTab3Selected}" />

                        <!-- History -->
                        <Border Background="{StaticResource AcsSurfaceCardBrush}" Padding="8,6"
                                IsVisible="{Binding IsTab4Selected}" MinHeight="80">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Command="{Binding OpenTransportCmdHistoryCommand}"
                                        Background="Transparent" BorderThickness="0" Padding="8,4">
                                    <StackPanel HorizontalAlignment="Center" Spacing="3">
                                        <TextBlock Text="📑" FontSize="22" HorizontalAlignment="Center" />
                                        <TextBlock Text="TrCmd History" FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource AcsTextPrimaryBrush}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding OpenVehicleHistoryCommand}"
                                        Background="Transparent" BorderThickness="0" Padding="8,4">
                                    <StackPanel HorizontalAlignment="Center" Spacing="3">
                                        <TextBlock Text="🚗" FontSize="22" HorizontalAlignment="Center" />
                                        <TextBlock Text="Vehicle History" FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource AcsTextPrimaryBrush}" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="NA_T_TRANSPORTCMD_HISTORY / NA_T_VEHICLE_HISTORY 조회 (시간/필터)"
                                           FontSize="11"
                                           Foreground="{StaticResource AcsTextMutedBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Log -->
                        <Border Background="{StaticResource AcsSurfaceCardBrush}" Padding="8,6"
                                IsVisible="{Binding IsTab5Selected}" MinHeight="80">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Command="{Binding OpenLogCommand}"
                                        Background="Transparent" BorderThickness="0" Padding="8,4">
                                    <StackPanel HorizontalAlignment="Center" Spacing="3">
                                        <TextBlock Text="📋" FontSize="22" HorizontalAlignment="Center" />
                                        <TextBlock Text="Log Viewer" FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource AcsTextPrimaryBrush}" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="NA_L_LOGMESSAGE 조회 (시간/레벨/키워드 필터)"
                                           FontSize="11"
                                           Foreground="{StaticResource AcsTextMutedBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Application -->
                        <views:ApplicationRibbonView DataContext="{Binding ApplicationViewModel}"
                                                     IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsTab6Selected}" />
                    </Panel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Area: 우측 탭 패널(Summary/Option) + Map -->
        <Grid Grid.Row="3" ColumnDefinitions="250,Auto,*">
            <TabControl Grid.Column="0"
                        Background="{StaticResource AcsSurfacePanelBrush}"
                        Padding="0"
                        BorderBrush="{StaticResource AcsSectionBorderBrush}"
                        BorderThickness="0,0,1,0">
                <TabControl.Styles>
                    <Style Selector="TabItem">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="MinHeight" Value="32" />
                        <Setter Property="Padding" Value="14,4" />
                        <Setter Property="Foreground" Value="{StaticResource AcsTextSecondaryBrush}" />
                    </Style>
                    <Style Selector="TabItem:selected">
                        <Setter Property="Foreground" Value="{StaticResource AcsLightBlueBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Style>
                </TabControl.Styles>
                <TabItem Header="Summary">
                    <views:SummaryView DataContext="{Binding SummaryViewModel}" />
                </TabItem>
                <TabItem Header="Option">
                    <views:OptionView DataContext="{Binding MapViewModel}" />
                </TabItem>
            </TabControl>
            <GridSplitter Grid.Column="1" Width="3"
                          Background="{StaticResource AcsBorderStrongBrush}" />
            <views:MapView Grid.Column="2"
                           DataContext="{Binding MapViewModel}" />
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="4"
                Background="{StaticResource AcsSurfacePanelBrush}"
                BorderBrush="{StaticResource AcsBorderStrongBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="10" Height="10"
                             Fill="{Binding ConnectionStatus, Converter={x:Static views:MainWindow.ConnectionStatusToColorConverter}}" />
                    <TextBlock Text="{Binding ConnectionStatus}"
                               Foreground="{StaticResource AcsTextSecondaryBrush}"
                               VerticalAlignment="Center"
                               FontSize="11" />
                </StackPanel>

                <!-- 자동 업데이트 배너: 새 버전 다운로드 완료 시에만 표시 (Viewer 권한은 다운로드 자체가 차단됨) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsVisible="{Binding IsUpdateReady}">
                    <TextBlock Text="{Binding UpdateReadyVersion, StringFormat='재시작하면 v{0} 업데이트가 적용됩니다'}"
                               Foreground="{StaticResource AcsTextSecondaryBrush}"
                               VerticalAlignment="Center"
                               FontSize="11" />
                    <Button Content="지금 재시작"
                            Command="{Binding RestartForUpdateCommand}"
                            Height="22" Padding="8,0" FontSize="11"
                            IsEnabled="{Binding Source={x:Static svc:UserSession.Current}, Path=CanUpdateUi, FallbackValue=False}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <!-- 현재 로그인 사용자 + 로그아웃 -->
                    <Border Background="{StaticResource AcsActiveTabBrush}" CornerRadius="3" Padding="8,2">
                        <TextBlock Text="{Binding Source={x:Static svc:UserSession.Current}, Path=DisplayName}"
                                   FontSize="11" Foreground="White" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Button Content="Logout" ToolTip.Tip="로그아웃 후 종료 — 재로그인 시 다시 실행하세요"
                            Command="{Binding LogoutCommand}"
                            Height="22" Padding="8,0" FontSize="11" />
                    <Border Width="1" Background="{StaticResource AcsSectionBorderBrush}" Margin="4,2" />
                    <TextBlock Text="{Binding LastUpdateTime, StringFormat='Last Update: {0}'}"
                               Foreground="{StaticResource AcsTextSecondaryBrush}"
                               VerticalAlignment="Center"
                               FontSize="11" />
                    <Button Content="&#x1F504;" ToolTip.Tip="Refresh"
                            Command="{Binding RefreshCommand}"
                            Width="22" Height="22" Padding="0" FontSize="11"
                            Background="Transparent"
                            Foreground="{StaticResource AcsTextPrimaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</Window>
