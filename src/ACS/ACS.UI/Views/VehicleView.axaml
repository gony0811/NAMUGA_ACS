<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ACS.UI.ViewModels"
             xmlns:svc="using:ACS.UI.Services"
             xmlns:models="using:ACS.UI.Models"
             x:Class="ACS.UI.Views.VehicleView"
             x:DataType="vm:VehicleViewModel">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Row 0: Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource AcsTabBarBrush}"
                BorderBrush="{StaticResource AcsSectionBorderBrush}"
                BorderThickness="0,0,0,1" Padding="6,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="&#x270F;" FontSize="14"
                               Foreground="{StaticResource AcsPrimaryBlueBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Vehicle" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource AcsPrimaryBlueBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalCount, StringFormat='[{0}] Rows'}"
                               FontSize="12"
                               Foreground="{StaticResource AcsTextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center" Margin="0,0,4,0">
                    <StackPanel.Styles>
                        <Style Selector="Button">
                            <Setter Property="Padding" Value="12,5" />
                            <Setter Property="FontSize" Value="12" />
                        </Style>
                    </StackPanel.Styles>
                    <Button Content="초기화" ToolTip.Tip="선택 차량 초기화 (ProcessingState=IDLE, TransferState=NOTASSIGNED, TransportCommandId 비움; 묶인 TransportCommand는 QUEUED로 환원)"
                            Command="{Binding ResetVehicleCommand}"
                            IsEnabled="{Binding Source={x:Static svc:UserSession.Current}, Path=CanEdit, FallbackValue=True}" />
                    <Border Width="1" Background="{StaticResource AcsSectionBorderBrush}" Margin="4,4" />
                    <Button Content="Refresh" ToolTip.Tip="Refresh" Command="{Binding LoadVehiclesCommand}" />
                </StackPanel>

                <Panel />
            </DockPanel>
        </Border>

        <!-- Row 1: Table Option -->
        <Border Grid.Row="1" Background="{StaticResource AcsSurfaceCardBrush}"
                BorderBrush="{StaticResource AcsSectionBorderBrush}"
                BorderThickness="0,0,0,1" Padding="6,4">
            <StackPanel>
                <TextBlock Text="&#x25BC; Table Option" FontSize="11"
                           Foreground="{StaticResource AcsTextPrimaryBrush}" />
                <TextBlock Text="NA_R_VEHICLE" FontSize="11" Margin="12,2,0,0"
                           Foreground="{StaticResource AcsPrimaryBlueBrush}" />
            </StackPanel>
        </Border>

        <!-- Row 2: Vehicle DataGrid -->
        <DataGrid Grid.Row="2"
                  Name="VehicleDataGrid"
                  ItemsSource="{Binding Vehicles}"
                  SelectedItem="{Binding SelectedVehicle}"
                  SelectionMode="Single"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  CanUserReorderColumns="True"
                  GridLinesVisibility="All"
                  BorderThickness="0"
                  Background="{StaticResource AcsSurfaceCardBrush}"
                  FontSize="11"
                  RowHeight="26"
                  HeadersVisibility="Column"
                  RowDetailsVisibilityMode="VisibleWhenSelected">

            <DataGrid.Styles>
                <Style Selector="DataGridColumnHeader">
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="Padding" Value="8,4" />
                </Style>
            </DataGrid.Styles>

            <!-- 선택 행 하부: 슬롯 4행 상세 (NA_R_VEHICLE_SLOT) -->
            <DataGrid.RowDetailsTemplate>
                <DataTemplate x:DataType="models:VehicleDto">
                    <Border Background="{StaticResource AcsGridStripeBrush}"
                            BorderBrush="{StaticResource AcsSectionBorderBrush}"
                            BorderThickness="0,1,0,1"
                            Padding="24,6,8,6">
                        <StackPanel Spacing="2">
                            <!-- 헤더 행 -->
                            <Grid ColumnDefinitions="60,90,90,300,70,150">
                                <TextBlock Grid.Column="0" Text="slotNo"      FontWeight="Bold" Foreground="{StaticResource AcsTextSecondaryBrush}" FontSize="10" />
                                <TextBlock Grid.Column="1" Text="role"        FontWeight="Bold" Foreground="{StaticResource AcsTextSecondaryBrush}" FontSize="10" />
                                <TextBlock Grid.Column="2" Text="state"       FontWeight="Bold" Foreground="{StaticResource AcsTextSecondaryBrush}" FontSize="10" />
                                <TextBlock Grid.Column="3" Text="jobId"       FontWeight="Bold" Foreground="{StaticResource AcsTextSecondaryBrush}" FontSize="10" />
                                <TextBlock Grid.Column="4" Text="phase"       FontWeight="Bold" Foreground="{StaticResource AcsTextSecondaryBrush}" FontSize="10" />
                                <TextBlock Grid.Column="5" Text="updatedTime" FontWeight="Bold" Foreground="{StaticResource AcsTextSecondaryBrush}" FontSize="10" />
                            </Grid>
                            <!-- 슬롯 행 -->
                            <ItemsControl ItemsSource="{Binding Slots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:VehicleSlotDto">
                                        <Grid ColumnDefinitions="60,90,90,300,70,150">
                                            <TextBlock Grid.Column="0" Text="{Binding SlotNo}" FontSize="11" />
                                            <TextBlock Grid.Column="1" Text="{Binding Role}"   FontSize="11" />
                                            <TextBlock Grid.Column="2" Text="{Binding State}"  FontSize="11" />
                                            <TextBlock Grid.Column="3" Text="{Binding JobId}"  FontSize="11" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="4" Text="{Binding Phase}"  FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource AcsPrimaryBlueBrush}" />
                                            <TextBlock Grid.Column="5" Text="{Binding UpdatedTime, StringFormat='yyyy-MM-dd HH:mm:ss'}" FontSize="11" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>

            <DataGrid.Columns>
                <DataGridTextColumn Header="vehicleId"           Binding="{Binding VehicleId}"           Width="100" />
                <DataGridTextColumn Header="bayId"               Binding="{Binding BayId}"               Width="80" />
                <DataGridTextColumn Header="carrierType"         Binding="{Binding CarrierType}"         Width="80" />
                <DataGridTextColumn Header="connectionState"     Binding="{Binding ConnectionState}"     Width="100" />
                <DataGridTextColumn Header="processingState"     Binding="{Binding ProcessingState}"     Width="100" />
                <DataGridTextColumn Header="runState"            Binding="{Binding RunState}"            Width="80" />
                <DataGridTextColumn Header="fullState"           Binding="{Binding FullState}"           Width="80" />
                <DataGridTextColumn Header="alarmState"          Binding="{Binding AlarmState}"          Width="80" />
                <DataGridTextColumn Header="transferState"       Binding="{Binding TransferState}"       Width="120" />
                <DataGridTextColumn Header="batteryRate"         Binding="{Binding BatteryRate}"         Width="70" />
                <DataGridTextColumn Header="batteryVoltage"      Binding="{Binding BatteryVoltage}"      Width="80" />
                <DataGridTextColumn Header="currentNodeId"       Binding="{Binding CurrentNodeId}"       Width="100" />
                <DataGridTextColumn Header="acsDestNodeId"       Binding="{Binding AcsDestNodeId}"       Width="100" />
                <DataGridTextColumn Header="vehicleDestNodeId"   Binding="{Binding VehicleDestNodeId}"   Width="110" />
                <DataGridTextColumn Header="transportCommandId"  Binding="{Binding TransportCommandId}"  Width="120" />
                <DataGridTextColumn Header="nodeCheckTime"       Binding="{Binding NodeCheckTime, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="140" />
                <DataGridTextColumn Header="eventTime"           Binding="{Binding EventTime, StringFormat='yyyy-MM-dd HH:mm:ss'}"     Width="140" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
