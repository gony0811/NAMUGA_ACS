<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ACS.UI.Views.ResetPasswordDialog"
        Title="Reset Password"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto">

        <TextBlock Grid.Row="0" x:Name="HeaderText"
                   FontSize="12" Margin="0,0,0,8" />

        <Grid Grid.Row="1" ColumnDefinitions="130,*" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="새 비밀번호:" VerticalAlignment="Center" FontSize="11" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="NewTextBox"
                     PasswordChar="*" FontSize="11" Height="28" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="비밀번호 확인:" VerticalAlignment="Center" FontSize="11" Margin="0,6,0,0" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="ConfirmTextBox"
                     PasswordChar="*" FontSize="11" Height="28" Margin="0,6,0,0" />
        </Grid>

        <TextBlock Grid.Row="2" x:Name="ErrorText"
                   Foreground="#D14343" FontSize="11"
                   Margin="0,8,0,0" IsVisible="False" TextWrapping="Wrap" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,12,0,0">
            <Button Content="Reset" Width="80" Height="28" Click="OnOkClick" IsDefault="True" />
            <Button Content="Cancel" Width="80" Height="28" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
