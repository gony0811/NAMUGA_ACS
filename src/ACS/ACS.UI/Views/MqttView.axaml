<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ACS.UI.ViewModels"
             x:Class="ACS.UI.Views.MqttView"
             x:DataType="vm:MqttViewModel">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Row 0: Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource AcsTabBarBrush}"
                BorderBrush="{StaticResource AcsSectionBorderBrush}"
                BorderThickness="0,0,0,1" Padding="6,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="&#x270F;" FontSize="14"
                               Foreground="{StaticResource AcsPrimaryBlueBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="MQTT" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource AcsPrimaryBlueBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalCount, StringFormat='[{0}] Rows'}"
                               FontSize="12"
                               Foreground="{StaticResource AcsTextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center" Margin="0,0,4,0">
                    <StackPanel.Styles>
                        <Style Selector="Button">
                            <Setter Property="Padding" Value="12,5" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </StackPanel.Styles>
                    <Button Content="Add" ToolTip.Tip="Add MQTT Config" Command="{Binding AddMqttConfigCommand}" />
                    <Button Content="Delete" ToolTip.Tip="Delete MQTT Config" Command="{Binding DeleteMqttConfigCommand}" />
                    <Button Content="Edit" ToolTip.Tip="Modify MQTT Config" Command="{Binding EditMqttConfigCommand}" />
                    <Border Width="1" Background="{StaticResource AcsSectionBorderBrush}" Margin="4,4" />
                    <Button Content="Refresh" ToolTip.Tip="Refresh" Command="{Binding LoadMqttConfigsCommand}" />
                </StackPanel>

                <Panel />
            </DockPanel>
        </Border>

        <!-- Row 1: Table Option -->
        <Border Grid.Row="1" Background="{StaticResource AcsSurfaceCardBrush}"
                BorderBrush="{StaticResource AcsSectionBorderBrush}"
                BorderThickness="0,0,0,1" Padding="6,4">
            <StackPanel>
                <TextBlock Text="&#x25BC; Table Option" FontSize="11"
                           Foreground="{StaticResource AcsTextPrimaryBrush}" />
                <TextBlock Text="NA_C_MQTT" FontSize="11" Margin="12,2,0,0"
                           Foreground="{StaticResource AcsPrimaryBlueBrush}" />
            </StackPanel>
        </Border>

        <!-- Row 2: MQTT DataGrid (Password 컬럼 미노출) -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding MqttConfigs}"
                  SelectedItem="{Binding SelectedMqttConfig}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  CanUserReorderColumns="True"
                  GridLinesVisibility="All"
                  BorderThickness="0"
                  Background="{StaticResource AcsSurfaceCardBrush}"
                  FontSize="11"
                  RowHeight="26"
                  HeadersVisibility="Column">

            <DataGrid.Styles>
                <Style Selector="DataGridColumnHeader">
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="Padding" Value="8,4" />
                </Style>
            </DataGrid.Styles>

            <DataGrid.Columns>
                <DataGridTextColumn Header="SEQ" Binding="{Binding Seq}" Width="60" />
                <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="140" />
                <DataGridTextColumn Header="APPLICATION" Binding="{Binding ApplicationName}" Width="120" />
                <DataGridTextColumn Header="WORKFLOW MGR" Binding="{Binding WorkflowManagerName}" Width="160" />
                <DataGridTextColumn Header="BROKER IP" Binding="{Binding BrokerIp}" Width="120" />
                <DataGridTextColumn Header="PORT" Binding="{Binding BrokerPort}" Width="60" />
                <DataGridTextColumn Header="TOPIC PREFIX" Binding="{Binding TopicPrefix}" Width="120" />
                <DataGridTextColumn Header="CLIENT ID" Binding="{Binding ClientId}" Width="140" />
                <DataGridTextColumn Header="USER" Binding="{Binding UserName}" Width="100" />
                <DataGridTextColumn Header="KEEPALIVE" Binding="{Binding KeepAliveSeconds}" Width="80" />
                <DataGridTextColumn Header="RECONNECT ms" Binding="{Binding ReconnectDelayMs}" Width="100" />
                <DataGridTextColumn Header="STATE" Binding="{Binding State}" Width="90" />
                <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
