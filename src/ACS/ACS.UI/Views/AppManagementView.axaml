<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ACS.UI.ViewModels"
             xmlns:models="using:ACS.UI.Models"
             xmlns:conv="using:ACS.UI.Converters"
             xmlns:svc="using:ACS.UI.Services"
             x:Class="ACS.UI.Views.AppManagementView"
             x:DataType="vm:AppManagementViewModel">

    <UserControl.Resources>
        <conv:ProcessStateToColorConverter x:Key="ProcessStateToColor" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ① Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource AcsTabBarBrush}"
                BorderBrush="{StaticResource AcsSectionBorderBrush}"
                BorderThickness="0,0,0,1" Padding="6,4">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <StackPanel.Styles>
                    <Style Selector="Button">
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                    <Style Selector="ToggleButton">
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </StackPanel.Styles>

                <TextBlock Text="Application Management"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource AcsTextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="4,0,12,0" />

                <Button Content="🔄 Refresh" Command="{Binding RefreshCommand}" />
                <ToggleButton Content="⟳ Auto Refresh" IsChecked="{Binding AutoRefreshEnabled}" />

                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="11" Foreground="{StaticResource AcsTextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0" />

            </StackPanel>
        </Border>

        <!-- ② 메인 영역: Primary | Secondary | Properties -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,1.5*">

            <!-- Primary 서버 트리 -->
            <Border Grid.Column="0"
                    BorderBrush="{StaticResource AcsSectionBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Background="{StaticResource AcsHeaderBrush}" Padding="8,4">
                        <TextBlock Text="Primary" Foreground="White"
                                   FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <TreeView Grid.Row="1"
                              ItemsSource="{Binding PrimaryProcesses}"
                              SelectedItem="{Binding SelectedProcess}"
                              Background="{StaticResource AcsSurfaceCardBrush}" Padding="4">
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True" />
                            </Style>
                        </TreeView.Styles>
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}"
                                              x:DataType="models:ProcessNodeModel">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <StackPanel.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="Padding" Value="6,1" />
                                            <Setter Property="FontSize" Value="10" />
                                            <Setter Property="MinWidth" Value="0" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </StackPanel.Styles>
                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                             IsVisible="{Binding IsApplication}"
                                             Fill="{Binding State, Converter={StaticResource ProcessStateToColor}}" />
                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                               VerticalAlignment="Center" />
                                    <Button Content="실행"
                                            IsVisible="{Binding IsApplication}"
                                            Command="{Binding $parent[TreeView].((vm:AppManagementViewModel)DataContext).StartCommand}"
                                            CommandParameter="{Binding}">
                                        <Button.IsEnabled>
                                            <MultiBinding Converter="{StaticResource BoolAnd}">
                                                <Binding Path="CanStart" />
                                                <Binding Source="{x:Static svc:UserSession.Current}" Path="CanEdit" />
                                            </MultiBinding>
                                        </Button.IsEnabled>
                                    </Button>
                                    <Button Content="정지"
                                            IsVisible="{Binding IsApplication}"
                                            Command="{Binding $parent[TreeView].((vm:AppManagementViewModel)DataContext).StopCommand}"
                                            CommandParameter="{Binding}">
                                        <Button.IsEnabled>
                                            <MultiBinding Converter="{StaticResource BoolAnd}">
                                                <Binding Path="CanStop" />
                                                <Binding Source="{x:Static svc:UserSession.Current}" Path="CanEdit" />
                                            </MultiBinding>
                                        </Button.IsEnabled>
                                    </Button>
                                    <Button Content="강제종료"
                                            IsVisible="{Binding IsApplication}"
                                            Command="{Binding $parent[TreeView].((vm:AppManagementViewModel)DataContext).ForceKillCommand}"
                                            CommandParameter="{Binding}">
                                        <Button.IsEnabled>
                                            <MultiBinding Converter="{StaticResource BoolAnd}">
                                                <Binding Path="CanForceKill" />
                                                <Binding Source="{x:Static svc:UserSession.Current}" Path="CanEdit" />
                                            </MultiBinding>
                                        </Button.IsEnabled>
                                    </Button>
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- Secondary 서버 트리 -->
            <Border Grid.Column="1"
                    BorderBrush="{StaticResource AcsSectionBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Background="{StaticResource AcsHeaderBrush}" Padding="8,4">
                        <TextBlock Text="Secondary" Foreground="White"
                                   FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <TreeView Grid.Row="1"
                              ItemsSource="{Binding SecondaryProcesses}"
                              SelectedItem="{Binding SelectedProcess}"
                              Background="{StaticResource AcsSurfaceCardBrush}" Padding="4">
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True" />
                            </Style>
                        </TreeView.Styles>
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}"
                                              x:DataType="models:ProcessNodeModel">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <StackPanel.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="Padding" Value="6,1" />
                                            <Setter Property="FontSize" Value="10" />
                                            <Setter Property="MinWidth" Value="0" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </StackPanel.Styles>
                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                             IsVisible="{Binding IsApplication}"
                                             Fill="{Binding State, Converter={StaticResource ProcessStateToColor}}" />
                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                               VerticalAlignment="Center" />
                                    <Button Content="실행"
                                            IsVisible="{Binding IsApplication}"
                                            Command="{Binding $parent[TreeView].((vm:AppManagementViewModel)DataContext).StartCommand}"
                                            CommandParameter="{Binding}">
                                        <Button.IsEnabled>
                                            <MultiBinding Converter="{StaticResource BoolAnd}">
                                                <Binding Path="CanStart" />
                                                <Binding Source="{x:Static svc:UserSession.Current}" Path="CanEdit" />
                                            </MultiBinding>
                                        </Button.IsEnabled>
                                    </Button>
                                    <Button Content="정지"
                                            IsVisible="{Binding IsApplication}"
                                            Command="{Binding $parent[TreeView].((vm:AppManagementViewModel)DataContext).StopCommand}"
                                            CommandParameter="{Binding}">
                                        <Button.IsEnabled>
                                            <MultiBinding Converter="{StaticResource BoolAnd}">
                                                <Binding Path="CanStop" />
                                                <Binding Source="{x:Static svc:UserSession.Current}" Path="CanEdit" />
                                            </MultiBinding>
                                        </Button.IsEnabled>
                                    </Button>
                                    <Button Content="강제종료"
                                            IsVisible="{Binding IsApplication}"
                                            Command="{Binding $parent[TreeView].((vm:AppManagementViewModel)DataContext).ForceKillCommand}"
                                            CommandParameter="{Binding}">
                                        <Button.IsEnabled>
                                            <MultiBinding Converter="{StaticResource BoolAnd}">
                                                <Binding Path="CanForceKill" />
                                                <Binding Source="{x:Static svc:UserSession.Current}" Path="CanEdit" />
                                            </MultiBinding>
                                        </Button.IsEnabled>
                                    </Button>
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- Properties + Heartbeat 설정 패널 -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto,Auto">
                <Border Grid.Row="0" Background="{StaticResource AcsHeaderBrush}" Padding="8,4">
                    <TextBlock Text="Properties" Foreground="White"
                               FontSize="12" FontWeight="SemiBold" />
                </Border>
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding SelectedProperties}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="False"
                          GridLinesVisibility="All"
                          BorderThickness="0"
                          Background="{StaticResource AcsSurfaceCardBrush}"
                          FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Property"
                                            Binding="{Binding Property}"
                                            Width="180" />
                        <DataGridTextColumn Header="Value"
                                            Binding="{Binding Value}"
                                            Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Heartbeat 설정 헤더 -->
                <Border Grid.Row="2" Background="{StaticResource AcsHeaderBrush}" Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Heartbeat 설정" Foreground="White"
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding HbStatusMessage}" Foreground="#DDFFFFFF"
                                   FontSize="10" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Heartbeat 설정 폼 -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" MaxHeight="320"
                              Background="{StaticResource AcsSurfaceCardBrush}">
                    <StackPanel Margin="10,8" Spacing="6">
                        <StackPanel.Styles>
                            <Style Selector="TextBlock.lbl">
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <Style Selector="NumericUpDown">
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="Height" Value="28" />
                                <Setter Property="Minimum" Value="0" />
                            </Style>
                            <Style Selector="ComboBox">
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="Height" Value="28" />
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                            </Style>
                        </StackPanel.Styles>

                        <Grid ColumnDefinitions="150,*">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="Heartbeat 사용" />
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding HbUseHeartBeat}"
                                          OnContent="ON" OffContent="OFF" HorizontalAlignment="Left" />
                        </Grid>

                        <Grid ColumnDefinitions="150,*">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="주기 Interval (ms)" />
                            <NumericUpDown Grid.Column="1" Increment="1000" Value="{Binding HbInterval}" />
                        </Grid>
                        <Grid ColumnDefinitions="150,*">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="시작 지연 (ms)" />
                            <NumericUpDown Grid.Column="1" Increment="1000" Value="{Binding HbStartDelay}" />
                        </Grid>
                        <Grid ColumnDefinitions="150,*">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="기동 유예 (ms)" />
                            <NumericUpDown Grid.Column="1" Increment="5000" Value="{Binding HbStartupGrace}" />
                        </Grid>
                        <Grid ColumnDefinitions="150,*">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="응답 타임아웃 (ms)" />
                            <NumericUpDown Grid.Column="1" Increment="1000" Value="{Binding HbTimeout}" />
                        </Grid>
                        <Grid ColumnDefinitions="150,*">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="재시도 횟수" />
                            <NumericUpDown Grid.Column="1" Increment="1" Maximum="20" Value="{Binding HbRetryCount}" />
                        </Grid>
                        <Grid ColumnDefinitions="150,*">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="재시도 타임아웃 (ms)" />
                            <NumericUpDown Grid.Column="1" Increment="1000" Value="{Binding HbRetryTimeout}" />
                        </Grid>

                        <Grid ColumnDefinitions="150,*">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="ProcessDown 시 동작" />
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding HbFailWhenProcessDown}">
                                <ComboBoxItem Content="없음" />
                                <ComboBoxItem Content="상태표시만(inactive)" />
                                <ComboBoxItem Content="재시작" />
                            </ComboBox>
                        </Grid>
                        <Grid ColumnDefinitions="150,*">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="ProcessHang 시 동작" />
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding HbFailWhenProcessHang}">
                                <ComboBoxItem Content="없음" />
                                <ComboBoxItem Content="상태표시만(hang)" />
                                <ComboBoxItem Content="Kill 후 재시작" />
                            </ComboBox>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                            <Button Content="💾 저장" Command="{Binding SaveHeartbeatSettingsCommand}"
                                    FontSize="11" Padding="10,4"
                                    IsEnabled="{Binding Source={x:Static svc:UserSession.Current}, Path=CanEdit, FallbackValue=True}" />
                            <Button Content="🔄 불러오기" Command="{Binding LoadHeartbeatSettingsCommand}"
                                    FontSize="11" Padding="10,4" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
